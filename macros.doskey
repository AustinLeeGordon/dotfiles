~=cd /d %USERPROFILE%
..=cd ..\$*
...=cd ..\..\$*
....=cd ..\..\..\$*
dl=cd /d %USERPROFILE%\Downloads
dt=cd /d %USERPROFILE%\Desktop
db=cd /d "%USERPROFILE%\Dropbox (Hutson Inc)"
c=cd /d %USERPROFILE%\Code
dot=cd /d %USERPROFILE%\Code\dotfiles
cat=type $*
clear=cls
cp=copy $*
e.=explorer .
ls=dir $*
man=help $*
mv=move $*
pwd=cd
rm=del $*
ga=git add $*
ga.=git add . $*
gb=git branch $*
gc=git commit $*
gcm=git commit -m $*
gco=git checkout $*
gmm=git merge master $*
gpl=git pull $*
gpu=git push $*
gpuu=git push -u $*
gpuuo=git push -u origin $*
gs=git status -s $*
nr=npm run $*
nrd=npm run dev
nrs=npm run start
nrt=npm run test
c.=code .
code.=code .
weather=curl wttr.in $*
